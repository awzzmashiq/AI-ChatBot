# Study Buddy AI Assistant - Production Environment Variables

# Required: Theta AI API Configuration
THETA_API_KEY=your_theta_api_key_here
THETA_API_URL=https://ondemand.thetaedgecloud.com/infer_request/llama_3_1_70b/completions

# Required: JWT Secret Key (change this in production!)
SECRET_KEY=your_secure_jwt_secret_key_here

# Optional: Google Drive Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# Optional: Basic Authentication (uncomment for additional security)
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=your_secure_password_here

# Optional: Demo Mode Configuration
# DEMO_MODE=false
# DEMO_CODE_1=INVESTOR_ACCESS_2024
# DEMO_CODE_2=POC_SHOWCASE_KEY
# DEMO_CODE_3=STARTUP_DEMO_PASS

# Optional: Database Configuration (if using external database)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Optional: Redis Configuration (if using Redis for sessions)
# REDIS_URL=redis://localhost:6379/0
